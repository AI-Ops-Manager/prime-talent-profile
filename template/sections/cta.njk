{# 最終ページ末尾の案内。ページ下端に寄せる #}
<div class="cta">
  <div class="cta-text">
    <div class="lead">{{ brand.labels.ctaLead }}</div>
    <p>{{ brand.labels.ctaBody }}</p>
  </div>
  <div class="who">
    {% if brand.logoHtml %}<span class="logo">{{ brand.logoHtml | safe }}</span>{% else %}<div class="bn">{{ brand.brandName }}</div>{% endif %}
    <div class="cn">{{ brand.companyName }}</div>
  </div>
</div>
