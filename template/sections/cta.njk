{# 最終ページ末尾の案内。ブランド色の面に白文字。ロゴは色が合わないことがあるので出さず、名義と会社名を文字で #}
<div class="cta">
  <div class="cta-text">
    <div class="lead">{{ brand.labels.ctaLead }}</div>
    <p>{{ brand.labels.ctaBody }}</p>
  </div>
  <div class="who">
    <div class="bn">{{ brand.brandName }}</div>
    <div class="cn">{{ brand.companyName }}</div>
  </div>
</div>
