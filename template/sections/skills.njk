{# スキル。分類ごとに1行（分類名と習熟｜タグ）。空なら節ごと出さない #}
{% if talent.skills and talent.skills.length %}
<div class="section">
  <div class="sec-head"><h2>スキル</h2></div>
  <div class="skills">
    {% for g in talent.skills %}
    <div class="skill">
      <div class="g"><span class="gname">{{ g.group }}</span>{% if g.level %}<span class="lvl">{{ g.level }}</span>{% endif %}</div>
      <div class="tags">{% for t in g.items %}<span class="tag">{{ t }}</span>{% endfor %}</div>
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}
