<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8" />
<title>タレントプロフィール {{ talent.initials }}（ブラインド版）</title>
{#
  タレント1名のブラインドプロフィール（A4縦）。
  - ページ割りとブランド値は scripts/render.mjs が解決して渡す。ここでは計算しない。
  - 見た目は template/styles.css。組版の基準値は docs/design.md。
  - セクションの増減は template/sections/ を編集する。
#}
{% if brand.typography.webFonts %}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&display=block" rel="stylesheet" />
{% endif %}
<style>
:root {
  --accent: {{ brand.colors.accent }};
  --accent-dark: {{ brand.colors.accentDark }};
  --accent-text: {{ brand.colors.accentText }};
  --tint: {{ brand.colors.tint }};
  --ink: {{ brand.colors.ink }};
  --body: {{ brand.colors.body }};
  --muted: {{ brand.colors.muted }};
  --hairline: {{ brand.colors.hairline }};
  --paper: {{ brand.colors.paper }};
  --logo-h: {{ brand.logoHeight }};
}
{{ css | safe }}
</style>
</head>
<body class="theme-{{ brand.theme }}">
{% for sections in pages %}
{% set pageNo = loop.index %}
<section class="page{% if sections.length >= 5 %} dense{% endif %}" data-page="{{ pageNo }}">
  <header class="head">
    <div class="head-l">
      {% if brand.logoHtml %}<span class="logo">{{ brand.logoHtml | safe }}</span>{% else %}<span class="brandtext">{{ brand.brandName }}</span>{% endif %}
    </div>
    <div class="head-r">
      {% if pageNo == 1 %}<span>{{ brand.labels.docTitle }}</span><span class="sep"></span><span class="num">{{ talent.issued }}</span>{% else %}<span class="num">{{ talent.initials }}</span><span class="sep"></span><span class="trunc">{{ talent.role }}</span>{% endif %}
    </div>
  </header>

  <div class="body">
    {% for s in sections %}{% include "sections/" + s + ".njk" %}{% endfor %}
  </div>

  <footer class="foot">
    <span class="foot-l">{{ brand.labels.footer }}</span>
    <span class="foot-r">{{ brand.labels.confidential }}<span class="pg">{{ pageNo }} / {{ meta.total }}</span></span>
  </footer>
</section>
{% endfor %}
</body>
</html>
